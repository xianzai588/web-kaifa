      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>活动卡片网格</title>\n    <style>\n    *{\n      box-sizing:border-box\n    }\n    body{\n      font:1rem/1.7 sans-serif;\n      margin:1rem\n    }.cards{\n      display:grid;\n      grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));\n      gap:16px;\n      max-width:960px\n    }.card{\n      min-width:0;\n      overflow-wrap:anywhere;\n      border:1px solid #999;\n      padding:16px\n    }.card h2{\n      font-size:1.2rem;\n      margin-top:0\n    }\n    </style>\n  </head>\n  <body>\n    <h1>活动卡片网格</h1>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <h2>HTML 入门</h2>\n        <p>从标题、段落和链接开始。</p>\n      </article>\n      <article class=\"card\">\n        <h2>CSS 排版</h2>\n        <p>先让内容容易阅读，再设计布局。</p>\n      </article>\n      <article class=\"card\">\n        <h2>长内容测试</h2>\n        <p>verylongfilenamewithoutspacesforgridtesting.html</p>\n      </article>\n    </div>\n  </body>\n</html>\n"
