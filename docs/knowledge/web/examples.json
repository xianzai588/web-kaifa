    "id": "web-forms",
    "kind": "html",
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>本地报名信息检查</title>\n    <style>\n    *{\n      box-sizing:border-box\n    }\n    body{\n      font:1rem/1.7 sans-serif;\n      max-width:36rem;\n      margin:1rem auto;\n      padding:1rem\n    }\n    label,input{\n      display:block\n    }\n    input{\n      width:100%;\n      padding:10px;\n      margin-bottom:16px\n    }\n    button{\n      padding:10px;\n      white-space:normal\n    }\n    input:focus-visible,button:focus-visible{\n      outline:3px solid #164e80;\n      outline-offset:3px\n    }\n    </style>\n  </head>\n  <body>\n    <h1>本地报名信息检查</h1>\n    <p>本页只检查输入，不发送报名信息。</p>\n    <form id=\"form\">\n      <label for=\"name\">称呼（必填）</label>\n      <input id=\"name\" name=\"name\" required maxlength=\"30\">\n      <label for=\"email\">邮箱（必填）</label>\n      <input id=\"email\" name=\"email\" type=\"email\" required>\n      <button type=\"submit\">检查信息</button>\n      <button type=\"button\" id=\"reset-input\">清空本地输入</button>\n    </form>\n    <p id=\"feedback\" role=\"status\">尚未检查。</p>\n    <script>\n    const form=document.querySelector('#form');\n    const feedback=document.querySelector('#feedback');\n    // 统一处理按钮与Enter触发的提交，之后只做本地校验，并未发送数据。\n    form.addEventListener('submit',event=>{\n      event.preventDefault();\n      const name=document.querySelector('#name').value.trim();\n      if(!name){\n        feedback.textContent='称呼不能只包含空格。';\n        document.querySelector('#name').focus();\n        return;\n      }\n      feedback.textContent=`${name}，信息通过本地检查，尚未提交或保存。`;\n    });\n    form.addEventListener('input',()=>{\n      feedback.textContent='输入已修改，请重新检查。';\n    });\n    document.querySelector('#reset-input').addEventListener('click',()=>{\n      form.reset();\n      feedback.textContent='本地输入已清空，未发送数据。';\n      document.querySelector('#name').focus();\n    });\n    </script>\n  </body>\n</html>\n"
    },
    "checks": [
      {
        "selector": "h1",
        "text": "本地报名信息检查"
      },
      {
        "selector": "#feedback",
        "text": "尚未检查。"
      }
    ]
  },
  {
    "id": "web-js",
    "kind": "html",
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>活动时长筛选</title>\n    <style>\n    *{\n      box-sizing:border-box\n    }\n    body{\n      font:1rem/1.7 sans-serif;\n      max-width:36rem;\n      margin:1rem auto;\n      padding:1rem\n    }\n    input,button{\n      max-width:100%;\n      padding:8px\n    }\n    pre{\n      white-space:pre-wrap;\n      overflow-wrap:anywhere\n    }\n    </style>\n  </head>\n  <body>\n    <h1>活动时长筛选</h1>\n    <label for=\"limit\">最多有几分钟（0—120）</label>\n    <input id=\"limit\" type=\"number\" value=\"30\" min=\"0\" max=\"120\">\n    <button type=\"button\" id=\"run\">计算</button>\n    <pre id=\"output\" aria-live=\"polite\">点击计算，查看筛选结果。</pre>\n    <script>\n    const activities=[{\n      title:'HTML',minutes:20\n    },{\n      title:'CSS',minutes:30\n    },{\n      title:'Go',minutes:40\n    }];\n    // 纯计算不读取DOM；filter先选对象，map再把各项变成标题文字。\n    function selectTitles(items,limit){\n      return items.filter(item=>item.minutes<=limit).map(item=>item.title);\n    }\n    document.querySelector('#run').addEventListener('click',()=>{\n      const raw=document.querySelector('#limit').value.trim();\n      const limit=Number(raw);\n      const output=document.querySelector('#output');\n      if(raw===''||!Number.isFinite(limit)||limit<0||limit>120){\n        output.textContent='请输入 0—120 之间的有限数字。';\n        return;\n      }\n      const titles=selectTitles(activities,limit);\n      output.textContent=titles.length?`匹配 ${titles.length} 项：${titles.join('、')}`:'没有匹配活动。';\n    });\n    </script>\n  </body>\n</html>\n"
    },
    "checks": [
      {
        "selector": "h1",
        "text": "活动时长筛选"
      },
      {
        "selector": "#output",
        "text": "点击计算，查看筛选结果。"
      }
    ]
  },
  {
    "id": "web-dom",
    "kind": "html",
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>活动搜索</title>\n    <style>\n    *{\n      box-sizing:border-box\n    }\n    body{\n      font:1rem/1.7 sans-serif;\n      max-width:36rem;\n      margin:1rem auto;\n      padding:1rem\n    }\n    input{\n      width:100%;\n      padding:10px\n    }\n    li{\n      overflow-wrap:anywhere\n    }\n    </style>\n  </head>\n  <body>\n    <h1>活动搜索</h1>\n    <label for=\"keyword\">标题关键词</label>\n    <input id=\"keyword\" type=\"search\">\n    <p id=\"count\" role=\"status\"></p>\n    <ul id=\"list\">\n    </ul>\n    <p>输入后即时筛选，本例不会发送输入。</p>\n    <script>\n    const items=['HTML 入门','CSS 排版','JavaScript 事件'];\n    const input=document.querySelector('#keyword');\n    const list=document.querySelector('#list');\n    const count=document.querySelector('#count');\n    function render(){\n      const keyword=input.value.trim().toLowerCase();\n      const matches=items.filter(title=>title.toLowerCase().includes(keyword));\n      // 每次重建当前结果，避免连续输入把旧行重复追加。\n      list.replaceChildren();\n      for(const title of matches){\n        const li=document.createElement('li');\n        li.textContent=title;\n        list.append(li);\n      }\n      count.textContent=matches.length?`找到 ${matches.length} 项`:'没有匹配项，请换一个关键词。';\n    }\n    input.addEventListener('input',render);\n    render();\n    </script>\n  </body>\n</html>\n"
    },
    "checks": [
      {
        "selector": "h1",
        "text": "活动搜索"
      },
      {
        "selector": "#count",
        "text": "找到 3 项"
      }
    ]
  },
  {
    "id": "web-fetch",
    "kind": "html",
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>请求状态实验</title>\n    <style>\n    *{\n      box-sizing:border-box\n    }\n    body{\n      font:1rem/1.7 sans-serif;\n      max-width:40rem;\n      margin:1rem auto;\n      padding:1rem\n    }\n    button{\n      padding:8px;\n      margin:4px;\n      max-width:100%;\n      white-space:normal\n    }\n    li{\n      overflow-wrap:anywhere\n    }\n    </style>\n  </head>\n  <body>\n    <h1>请求状态实验</h1>\n    <p>只在点击后请求本地练习文件，不访问外部接口。</p>\n    <div>\n      <button type=\"button\" data-file=\"items.json\">正常数据</button>\n      <button type=\"button\" data-file=\"empty.json\">空数组</button>\n      <button type=\"button\" data-file=\"missing.json\">404</button>\n      <button type=\"button\" data-file=\"broken.json\">坏 JSON</button>\n      <button type=\"button\" data-file=\"wrong.json\">结构错误</button>\n    </div>\n    <p id=\"status\" role=\"status\">请选择一种响应情况。</p>\n    <ul id=\"list\">\n    </ul>\n    <script>\n    const status=document.querySelector('#status');\n    const list=document.querySelector('#list');\n    let latest=0;\n    async function load(file){\n      // 固定本次编号；其他调用继续增加latest不会改变这个局部version。\n      const version=++latest;\n      status.textContent='正在加载…';\n      list.replaceChildren();\n      try{\n        const response=await fetch(`./${file}`,{\n          cache:'no-store'\n        });\n        if(!response.ok)throw new Error(`HTTP ${response.status}`);\n        const items=await response.json();\n        if(!Array.isArray(items)||!items.every(item=>item&&typeof item.title==='string'))throw new Error('数据结构错误：期待带 title 字符串的对象数组');\n        // 成功和失败都检查，过期操作不能覆盖最新选择。\n        if(version!==latest)return;\n        for(const item of items){\n          const li=document.createElement('li');\n          li.textContent=item.title;\n          list.append(li);\n        }\n        status.textContent=items.length?`加载成功：${items.length} 项`:'加载成功，但目前没有活动。';\n      }\n      catch(error){\n        // 成功和失败都检查，过期操作不能覆盖最新选择。\n        if(version!==latest)return;\n        status.textContent=`加载失败：${error.message}。请检查后重试。`;\n      }\n    }\n    document.querySelectorAll('[data-file]').forEach(button=>button.addEventListener('click',()=>load(button.dataset.file)));\n    </script>\n  </body>\n</html>\n",
      "items.json": "[\n  {\n    \"title\": \"HTML 入门\"\n  },\n  {\n    \"title\": \"CSS 排版\"\n  }\n]\n",
      "empty.json": "[]\n",
      "broken.json": "{ this is not json }\n",
      "wrong.json": "{\n  \"title\": \"不是数组\"\n}\n"
    },
    "checks": [
      {
        "selector": "h1",
        "text": "请求状态实验"
      },
      {
        "selector": "#status",
        "text": "请选择一种响应情况。"
      }
